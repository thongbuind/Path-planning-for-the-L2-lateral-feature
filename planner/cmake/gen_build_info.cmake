# Writes pp_build_info.h: the identification string returned by pp_version()
# (R79 Annex 6 3.3.5; research/README.md). Runs at every build; the header is only
# rewritten when the string changes, so an unchanged build does not recompile.
#
#   cmake -DOUT=<header> -DREPO=<repository root> -DCAL=<calibration.yaml>
#         -DVERSION=<x.y.z> -DT7=<quintic|qp> -DT4=<single|per_time> -DT2=<arc|rate_limited>
#         -P gen_build_info.cmake
#
# commit: HEAD of the repository; "-dirty" when planner/ or interfaces/c has uncommitted
# changes, i.e. when the library may differ from that commit.
# calibration: first 12 hex digits of the sha256 of the calibration file built in.

execute_process(COMMAND git rev-parse --short=12 HEAD
                WORKING_DIRECTORY ${REPO} RESULT_VARIABLE rc
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
else()
    execute_process(COMMAND git status --porcelain -- planner interfaces/c
                    WORKING_DIRECTORY ${REPO}
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT changes STREQUAL "")
        string(APPEND commit "-dirty")
    endif()
endif()

file(SHA256 ${CAL} cal_sha)
string(SUBSTRING ${cal_sha} 0 12 cal_id)

set(text "/* Generated by planner/cmake/gen_build_info.cmake. Do not edit. */
#ifndef PP_BUILD_INFO_H
#define PP_BUILD_INFO_H
#define PP_BUILD_INFO \"pp_planner ${VERSION} commit ${commit} calibration ${cal_id} t7 ${T7} t4 ${T4} t2 ${T2}\"
#endif /* PP_BUILD_INFO_H */
")

set(old "")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
